:root{--bg:#071018;--bg2:#0b1520;--card:#0d1824;--line:#1b3042;--text:#eef7ff;--muted:#9aabbd;--green:#65e7be;--blue:#7cb1ff;--max:1180px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 85% 8%,rgba(101,231,190,.08),transparent 28%),radial-gradient(circle at 10% 80%,rgba(124,177,255,.06),transparent 30%),var(--bg);color:var(--text);font:15px/1.7 Inter,system-ui,sans-serif}a{text-decoration:none;color:inherit}.container{width:min(var(--max),calc(100% - 40px));margin:auto}.glow{position:fixed;width:380px;height:380px;border-radius:50%;filter:blur(110px);pointer-events:none;z-index:-1;opacity:.12}.glow-a{background:var(--green);top:-180px;right:-140px}.glow-b{background:var(--blue);bottom:-190px;left:-130px}
header{position:sticky;top:0;z-index:20;background:rgba(7,16,24,.78);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.04)}.nav{height:72px;display:flex;align-items:center;justify-content:space-between}.logo{font-weight:800;letter-spacing:.13em}.logo span{color:var(--green)}nav{display:flex;gap:28px;color:var(--muted);font-size:.9rem}nav a:hover{color:var(--text)}#menu{display:none;background:none;border:0;color:var(--text);font-size:1.3rem}
.hero{padding:105px 0 95px;display:grid;grid-template-columns:1.08fr .92fr;gap:65px;align-items:center}.eyebrow{font:600 .75rem "JetBrains Mono",monospace;color:var(--muted);display:flex;gap:8px;align-items:center}.pulse{width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 18px rgba(101,231,190,.7)}h1{font-size:clamp(3.1rem,7vw,6rem);line-height:.98;letter-spacing:-.065em;margin:24px 0}h1 em{font-style:normal;background:linear-gradient(120deg,#fff,var(--green));-webkit-background-clip:text;color:transparent}.lead{font-size:1.15rem;color:#c8d7e6;max-width:720px}.note{color:var(--muted);max-width:720px}.actions{display:flex;gap:12px;margin:28px 0 22px}.btn{border:1px solid var(--line);border-radius:11px;padding:11px 17px;font-weight:700;font-size:.88rem}.btn.primary{background:var(--green);color:#04120d;border-color:var(--green)}.tag-row,.chips,.skill-tags{display:flex;flex-wrap:wrap;gap:7px}.tag-row span,.chips span,.skill-tags span{border:1px solid var(--line);background:rgba(255,255,255,.02);padding:5px 9px;border-radius:999px;color:#bdccdc;font-size:.72rem}
.card,.project{background:rgba(13,24,36,.86);border:1px solid var(--line);border-radius:18px}.terminal{overflow:hidden;box-shadow:0 25px 70px rgba(0,0,0,.3)}.terminal-head{padding:14px 17px;display:flex;justify-content:space-between;border-bottom:1px solid var(--line);font:500 .76rem "JetBrains Mono",monospace;color:var(--muted)}.live{display:flex;gap:7px;align-items:center}.live i{width:7px;height:7px;border-radius:50%;background:var(--green)}pre{margin:0;padding:25px;font:500 .8rem/1.7 "JetBrains Mono",monospace;white-space:pre-wrap;color:#dbe9f6}.c{color:var(--green)}.out{color:var(--muted)}.accent{color:#9dc3ff}
.section{padding:105px 0}.alt{background:rgba(255,255,255,.018);border-block:1px solid rgba(255,255,255,.03)}.section-head{margin-bottom:50px}.section-head small,.project small,.edu small,.contact-card small,.life-grid small{font:600 .72rem "JetBrains Mono",monospace;color:var(--blue);letter-spacing:.14em}.section-head h2{font-size:clamp(2rem,4vw,3.15rem);line-height:1.08;letter-spacing:-.04em;margin:10px 0 0;max-width:850px}.two-col{display:grid;grid-template-columns:1.1fr .9fr;gap:60px}.copy p{color:var(--muted);max-width:760px}.copy strong{color:var(--text)}.principles{display:grid;gap:12px}.principles .card{padding:20px}.principles b{font-size:1rem}.principles p{margin:6px 0 0;color:var(--muted);font-size:.88rem}
.timeline{display:grid;gap:24px}.timeline article{display:grid;grid-template-columns:150px 20px 1fr;gap:15px}.date{color:var(--blue);font:500 .72rem "JetBrains Mono",monospace;padding-top:6px}.line{position:relative}.line:before{content:"";position:absolute;top:10px;left:5px;width:9px;height:9px;background:var(--green);border-radius:50%;box-shadow:0 0 16px rgba(101,231,190,.45)}.timeline article:not(:last-child) .line:after{content:"";position:absolute;top:20px;left:9px;width:1px;height:calc(100% + 24px);background:var(--line)}.timeline .card{padding:23px}.role{display:flex;justify-content:space-between;gap:20px;align-items:baseline}.role h3{margin:0;font-size:1.08rem}.role span{color:var(--muted);font-size:.85rem}.timeline ul{margin:15px 0;padding-left:18px;color:var(--muted)}.timeline li{margin:6px 0}
.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.project{padding:25px;min-height:225px;transition:.2s}.project:hover,.skill-grid .card:hover,.edu:hover{transform:translateY(-3px);border-color:#29465f}.project.featured{background:linear-gradient(145deg,rgba(101,231,190,.08),rgba(124,177,255,.04));border-color:#2a493f}.project h3{font-size:1.35rem;margin:13px 0 8px}.project p{color:var(--muted);font-size:.9rem}
.skill-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.skill-grid .card,.edu{padding:23px}.skill-grid h3{margin:0 0 17px;font-size:1rem}.focus{margin-top:16px;border:1px solid #284a40;border-radius:15px;padding:16px 18px;color:var(--muted);background:rgba(101,231,190,.035)}.focus strong{color:var(--text)}
.edu-grid,.life-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.edu small{display:block}.edu h3{font-size:1.22rem;margin:10px 0 4px}.edu p{color:var(--muted);margin:0 0 6px}.edu b{display:block;margin-bottom:16px}.life-grid{margin-top:16px}.life-grid .card{padding:21px}.life-grid h3{margin:8px 0 4px}.life-grid p{color:var(--muted);margin:0;font-size:.88rem}
.contact-card{padding:35px;border:1px solid #2a4b42;border-radius:22px;background:linear-gradient(140deg,rgba(101,231,190,.07),rgba(124,177,255,.04));display:flex;justify-content:space-between;gap:40px;align-items:end}.contact-card h2{font-size:clamp(2rem,4vw,3.4rem);line-height:1.05;letter-spacing:-.04em;margin:10px 0}.contact-card p{color:var(--muted);max-width:680px}.links{display:grid;gap:9px;min-width:190px}.links a{border:1px solid var(--line);padding:11px 13px;border-radius:11px;font-size:.85rem}.links a:hover{border-color:#31506b}
footer{border-top:1px solid var(--line);padding:23px 0;color:var(--muted);font-size:.75rem}.foot{display:flex;justify-content:space-between;gap:15px}
@media(max-width:900px){.hero,.two-col,.skill-grid,.edu-grid{grid-template-columns:1fr}.projects{grid-template-columns:1fr}.contact-card{display:block}.links{margin-top:22px}.role{display:block}.role span{display:block;margin-top:4px}.timeline article{grid-template-columns:1fr}.line{display:none}.date{padding-bottom:2px}}
@media(max-width:700px){.container{width:min(var(--max),calc(100% - 28px))}.section{padding:80px 0}.hero{padding-top:70px}.nav nav{display:none}.nav nav.open{display:flex;position:absolute;left:0;right:0;top:72px;background:#071018;padding:20px;flex-direction:column;border-bottom:1px solid var(--line)}#menu{display:block}.foot{flex-direction:column}.actions{flex-wrap:wrap}}
